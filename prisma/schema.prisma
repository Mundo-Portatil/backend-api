datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS GLOBALES
// ==========================================

enum Role {
  ADMIN
  ENCARGADO_ALMACEN
  VENDEDOR
  TECNICO
}

enum LocationType {
  ALMACEN_CENTRAL
  PUESTO
}

enum ItemStatus {
  EN_STOCK
  VENDIDO
  SEGUNDA_MANO_PENDIENTE
  EN_GARANTIA
  DE_BAJA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntryMethod {
  ESCANER
  MANUAL
  LOTE
}

enum TransferType {
  DIRECTO
}

enum TransferStatus {
  COMPLETED
}

enum ServiceOrderStatus {
  RECIBIDO
  EN_REPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  TRANSFERENCIA
}

enum CustomerDocumentType {
  SIN_DOCUMENTO
  DNI
  RUC
  CE
}

enum ReceiptType {
  BOLETA_INTERNA
  BOLETA
  FACTURA
}

enum SunatStatus {
  NO_APLICA
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

// ==========================================
// M5 Y M6: UBICACIONES Y USUARIOS (RBAC)
// ==========================================

model User {
  id                   String                     @id @default(uuid())
  email                String                     @unique
  name                 String
  password             String
  role                 Role                       @default(VENDEDOR)
  locationId           String?
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  location             Location?                  @relation(fields: [locationId], references: [id])
  cashClosings         CashClosing[]
  transfersCreated     InternalTransfer[]         @relation("TransferCreatedBy")
  auditLogs            AuditLog[]
  serviceOrders        TechnicalServiceOrder[]
  passThroughRequested PassThroughApprovalQueue[] @relation("PassThroughRequester")
  passThroughReviewed  PassThroughApprovalQueue[] @relation("PassThroughReviewer")

  @@map("users")
}

model Location {
  id                  String                 @id @default(uuid())
  name                String                 // Ej: "Almacén Central", "Puesto 102"
  type                LocationType           @default(PUESTO)
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())

  users               User[]
  items               HardwareItem[]
  quantityStocks      QuantityStock[]
  sourceTransfers     InternalTransfer[]     @relation("TransferFromLocation")
  targetTransfers     InternalTransfer[]     @relation("TransferToLocation")
  serviceOrders       TechnicalServiceOrder[]
  sourceServiceItems  ServiceItem[]          @relation("ServiceItemSourceLocation")
  cashClosings        CashClosing[]
  audits              AuditSession[]

  @@map("locations")
}

// ==========================================
// M1 Y M6: CATEGORÍAS DINÁMICAS Y CATÁLOGO
// ==========================================

model ComponentCategory {
  id          String           @id @default(uuid())
  name        String           @unique // Ej: "LAPTOP", "RAM", "SSD", "COOLER_LIQUIDO", "MONITOR"
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  products    ProductCatalog[]

  @@map("component_categories")
}

model ProductCatalog {
  id                   String                     @id @default(uuid())
  sku                  String                     @unique // Código de catálogo / Modelo interno
  brand                String                     // Ej: "Acer", "Asus", "Micronics", "Teros"
  model                String                     // Ej: "A515-56", "TE3023 BK"
  categoryId           String                     // Relación con ComponentCategory (Dinámico)
  
  // Ficha técnica para equipos
  processor            String?                    // Ej: "i5 13420H", "Ultra 9 275HX", "R7 8845HS"
  ramCapacity          String?                    // Ej: "16GB", "32GB", "8GB DDR5"
  storageCapacity      String?                    // Ej: "512GB SSD", "2TB SSD"
  gpu                  String?                    // Ej: "RTX 3050 4GB", "Integrada"
  screenSize           String?                    // Ej: "15.6”"

  isSerialized         Boolean                    @default(true) // true = Con N/S Único. false = Control Cuantitativo.
  minStockThreshold    Int                        @default(2)
  basePrice            Decimal                    @db.Decimal(10, 2)
  isSecondHand         Boolean                    @default(false)
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())

  category             ComponentCategory          @relation(fields: [categoryId], references: [id])
  items                HardwareItem[]
  quantityStocks       QuantityStock[]
  transferItems        InternalTransferItem[]
  serviceItems         ServiceItem[]
  passThroughApprovals PassThroughApprovalQueue[]

  @@map("product_catalog")
}

// ------------------------------------------
// 1. PRODUCTOS SERIALIZADOS (Con N/S individual)
// ------------------------------------------
model HardwareItem {
  id              String         @id @default(uuid())
  serialNumber    String         @unique
  catalogId       String
  locationId      String
  status          ItemStatus     @default(EN_STOCK)
  
  // Relación Padre-Hijo para modificaciones/upgrades internos
  parentChassisId String?        
  parentChassis   HardwareItem?  @relation("LaptopComponents", fields: [parentChassisId], references: [id])
  components      HardwareItem[] @relation("LaptopComponents")

  costPrice       Decimal?       @db.Decimal(10, 2)
  salePrice       Decimal?       @db.Decimal(10, 2)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  catalog         ProductCatalog @relation(fields: [catalogId], references: [id])
  location        Location       @relation(fields: [locationId], references: [id])

  saleItems       SaleItem[]
  transferItems   InternalTransferItem[]
  secondHandQueue SecondHandApprovalQueue[]
  serviceItems    ServiceItem[]

  @@map("hardware_items")
}

// ------------------------------------------
// 2. PRODUCTOS POR CANTIDAD (Mouses, Periféricos, Fuentes)
// ------------------------------------------
model QuantityStock {
  id            String         @id @default(uuid())
  catalogId     String
  locationId    String
  quantity      Int            @default(0) // Control de unidades físicas
  costPrice     Decimal?       @db.Decimal(10, 2)
  salePrice     Decimal?       @db.Decimal(10, 2)
  updatedAt     DateTime       @updatedAt

  catalog       ProductCatalog @relation(fields: [catalogId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])

  saleItems     SaleItem[]

  @@unique([catalogId, locationId])
  @@map("quantity_stocks")
}

// ==========================================
// M5: COLAS DE APROBACIÓN (SEGUNDA MANO Y PASES)
// ==========================================

model SecondHandApprovalQueue {
  id                  String         @id @default(uuid())
  itemId              String
  extractedFromSaleId String?
  requestedByUserId   String
  status              ApprovalStatus @default(PENDING)
  notes               String?
  createdAt           DateTime       @default(now())

  item                HardwareItem   @relation(fields: [itemId], references: [id])

  @@map("second_hand_approval_queue")
}

model PassThroughApprovalQueue {
  id                String          @id @default(uuid())
  saleItemId        String          @unique
  tempModelName     String          // Modelo rápido capturado en el POS
  sourceVendor      String          // Puesto o proveedor vecino de origen
  serialNumber      String?         // N/S opcional para ticket y garantía
  purchasePrice     Decimal         @db.Decimal(10, 2) // Costo pagado/acordado con el vecino
  salePrice         Decimal         @db.Decimal(10, 2) // Precio cobrado al cliente
  isPaidFromCash    Boolean         @default(false)    // true = Se sacó efectivo de caja al momento
  isSettled         Boolean         @default(false)    // true = Deuda con puesto vecino ya liquidada
  status            ApprovalStatus  @default(PENDING)
  approvedCatalogId String?         // Se vincula al catálogo (M1) cuando la Admin aprueba
  requestedByUserId String
  reviewedByUserId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItem          SaleItem        @relation(fields: [saleItemId], references: [id])
  approvedCatalog   ProductCatalog? @relation(fields: [approvedCatalogId], references: [id])
  requestedBy       User            @relation("PassThroughRequester", fields: [requestedByUserId], references: [id])
  reviewedBy        User?           @relation("PassThroughReviewer", fields: [reviewedByUserId], references: [id])

  @@map("pass_through_approval_queue")
}

// ==========================================
// M2: VENTAS, GARANTÍAS Y REGALOS (POS)
// ==========================================

model Sale {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  cashierUserId String
  locationId    String
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(EFECTIVO)
  entryMethod   EntryMethod   @default(ESCANER)
  isSynced      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id                   String                    @id @default(uuid())
  saleId               String
  itemId               String?                   // Ítem serializado propio (si aplica)
  quantityStockId      String?                   // Stock cuantitativo propio (si aplica)
  quantity             Int                       @default(1)
  unitPrice            Decimal                   @db.Decimal(10, 2)
  isGift               Boolean                   @default(false)
  isUpgradeReplacement Boolean                   @default(false)
  isPassThrough        Boolean                   @default(false) // true = Producto obtenido por pase de otro puesto

  sale                 Sale                      @relation(fields: [saleId], references: [id])
  item                 HardwareItem?             @relation(fields: [itemId], references: [id])
  quantityStock        QuantityStock?            @relation(fields: [quantityStockId], references: [id])
  passThroughRecord    PassThroughApprovalQueue?

  @@map("sale_items")
}

// ==========================================
// M3: LOGÍSTICA Y BORRADORES
// ==========================================

model InternalTransfer {
  id             String                 @id @default(uuid())
  code           String                 @unique // Código legible ej: "TR-000101"
  type           TransferType           @default(DIRECTO)
  status         TransferStatus         @default(COMPLETED)
  fromLocationId String
  toLocationId   String
  createdById    String
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  fromLocation   Location               @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location               @relation("TransferToLocation", fields: [toLocationId], references: [id])
  createdBy      User                   @relation("TransferCreatedBy", fields: [createdById], references: [id])
  items          InternalTransferItem[]

  @@map("internal_transfers")
}

model InternalTransferItem {
  id             String           @id @default(uuid())
  transferId     String
  catalogId      String
  hardwareItemId String?          // N/S serializado si aplica
  quantity       Int              @default(1) // 1 para serializados, >= 1 para cuantitativos

  transfer       InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  catalog        ProductCatalog   @relation(fields: [catalogId], references: [id])
  hardwareItem   HardwareItem?    @relation(fields: [hardwareItemId], references: [id])

  @@map("internal_transfer_items")
}

// ==========================================
// M4: AUDITORÍA EXPRESS Y ESCANEO MÓVIL
// ==========================================

model AuditSession {
  id            String      @id @default(uuid())
  locationId    String
  auditorUserId String
  deviceType    String      @default("PC")
  status        String      @default("IN_PROGRESS")
  createdAt     DateTime    @default(now())

  location      Location    @relation(fields: [locationId], references: [id])
  items         AuditItem[]

  @@map("audit_sessions")
}

model AuditItem {
  id              String       @id @default(uuid())
  auditSessionId  String
  scannedSerial   String
  isDiscrepancy   Boolean      @default(false)
  discrepancyNote String?

  auditSession    AuditSession @relation(fields: [auditSessionId], references: [id])

  @@map("audit_items")
}

// ==========================================
// M7: SERVICIO TÉCNICO
// ==========================================

model TechnicalServiceOrder {
  id                   String               @id @default(uuid())
  code                 String               @unique // Ej: "OS-4A9B1C"
  locationId           String
  technicianId         String
  customerName         String
  customerDocumentType CustomerDocumentType @default(SIN_DOCUMENTO)
  customerDocument     String?
  customerPhone        String?
  customerAddress      String?
  deviceBrand          String
  deviceModel          String
  deviceSerial         String?
  deviceAccessories    String?
  reportedIssue        String
  technicalNotes       String?
  extractedPartsNotes  String?
  laborCost            Decimal              @default(0.00) @db.Decimal(10, 2)
  partsTotal           Decimal              @default(0.00) @db.Decimal(10, 2)
  totalAmount          Decimal              @default(0.00) @db.Decimal(10, 2)
  status               ServiceOrderStatus   @default(RECIBIDO)
  cancelReason         String?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  location             Location             @relation(fields: [locationId], references: [id])
  technician           User                 @relation(fields: [technicianId], references: [id])
  items                ServiceItem[]
  payments             ServiceOrderPayment[]
  receipt              ServiceReceipt?

  @@map("technical_service_orders")
}

model ServiceItem {
  id                String                @id @default(uuid())
  serviceOrderId    String
  catalogId         String
  hardwareItemId    String?
  sourceLocationId  String
  isFromOtherPuesto Boolean               @default(false)
  quantity          Int                   @default(1)
  unitPrice         Decimal               @db.Decimal(10, 2)
  subtotal          Decimal               @db.Decimal(10, 2)
  createdAt         DateTime              @default(now())

  serviceOrder      TechnicalServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  catalog           ProductCatalog        @relation(fields: [catalogId], references: [id])
  hardwareItem      HardwareItem?         @relation(fields: [hardwareItemId], references: [id])
  sourceLocation    Location              @relation("ServiceItemSourceLocation", fields: [sourceLocationId], references: [id])

  @@map("service_items")
}

model ServiceOrderPayment {
  id             String                @id @default(uuid())
  serviceOrderId String
  method         PaymentMethod
  amount         Decimal               @db.Decimal(10, 2)
  reference      String?
  createdAt      DateTime              @default(now())

  serviceOrder   TechnicalServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("service_order_payments")
}

model ServiceReceipt {
  id                   String                @id @default(uuid())
  serviceOrderId       String                @unique
  receiptType          ReceiptType           @default(BOLETA_INTERNA)
  series               String                // Ej: "BS01", "B001", "F001"
  correlative          String                // Ej: "000001"
  fullNumber           String                @unique // Ej: "BS01-000001"
  customerName         String
  customerDocumentType CustomerDocumentType
  customerDocument     String?
  customerAddress      String?
  currency             String                @default("PEN")
  subtotal             Decimal               @db.Decimal(10, 2)
  igvAmount            Decimal               @db.Decimal(10, 2)
  totalAmount          Decimal               @db.Decimal(10, 2)
  sunatStatus          SunatStatus           @default(NO_APLICA)
  sunatHash            String?
  sunatCdrCode         String?
  sunatXmlUrl          String?
  sunatPdfUrl          String?
  issuedAt             DateTime              @default(now())

  serviceOrder         TechnicalServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("service_receipts")
}

// ==========================================
// M8: HISTORIAL Y CIERRE DE CAJA
// ==========================================

model CashClosing {
  id                  String   @id @default(uuid())
  locationId          String
  userId              String
  totalCashFound      Decimal  @db.Decimal(10, 2)
  amountWithdrawn     Decimal  @db.Decimal(10, 2)
  retainedBalance     Decimal  @db.Decimal(10, 2)
  passThroughExpenses Decimal  @default(0.00) @db.Decimal(10, 2) // Egresos pagados en efectivo por productos de pase
  expectedBalance     Decimal  @db.Decimal(10, 2)
  difference          Decimal  @db.Decimal(10, 2)
  notes               String?
  closedAt            DateTime @default(now())

  location            Location @relation(fields: [locationId], references: [id])
  user                User     @relation(fields: [userId], references: [id])

  @@map("cash_closings")
}

// ==========================================
// M6: BITÁCORA INALTERABLE (AUDIT LOG)
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  payload   Json
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}