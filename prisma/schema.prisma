datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS GLOBALES
// ==========================================

enum Role {
  ADMIN
  VENDEDOR
  TECNICO
}

enum LocationType {
  ALMACEN_CENTRAL
  PUESTO
}

enum ItemStatus {
  EN_STOCK
  VENDIDO
  SEGUNDA_MANO_PENDIENTE
  EN_GARANTIA
  DE_BAJA
}

enum EntryMethod {
  ESCANER
  MANUAL
  LOTE
}

enum TransferStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum ServiceStatus {
  RECIBIDO
  EN_DIAGNOSTICO
  EN_REPARACION
  LISTO_PARA_ENTREGA
  ENTREGADO_Y_LIQUIDADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MIXTO
}

// ==========================================
// M5 Y M6: UBICACIONES Y USUARIOS (RBAC)
// ==========================================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  role          Role           @default(VENDEDOR)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cashClosings  CashClosing[]
  transfersSent TransferRequest[] @relation("TransferSender")
  transfersRecv TransferRequest[] @relation("TransferReceiver")
  auditLogs     AuditLog[]
  ordersTech    TechnicalServiceOrder[]

  @@map("users")
}

model Location {
  id              String            @id @default(uuid())
  name            String            // Ej: "Almacén Central", "Puesto 102"
  type            LocationType      @default(PUESTO)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())

  items           HardwareItem[]
  quantityStocks  QuantityStock[]
  sourceTransfers TransferRequest[] @relation("SourceLocation")
  targetTransfers TransferRequest[] @relation("TargetLocation")
  cashClosings    CashClosing[]
  audits          AuditSession[]

  @@map("locations")
}

// ==========================================
// M1 Y M6: CATEGORÍAS DINÁMICAS Y CATÁLOGO
// ==========================================

model ComponentCategory {
  id          String           @id @default(uuid())
  name        String           @unique // Ej: "LAPTOP", "RAM", "SSD", "COOLER_LIQUIDO", "MONITOR"
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  products    ProductCatalog[]

  @@map("component_categories")
}

model ProductCatalog {
  id                String            @id @default(uuid())
  sku               String            @unique // Código de catálogo / Modelo interno
  name              String            // Ej: "Acer Aspire 15", "Fuente Micronics 650W"
  brand             String            // Ej: "Acer", "Asus", "Micronics", "Teros"
  model             String            // Ej: "A515-56", "TE3023 BK"
  categoryId        String            // Relación con ComponentCategory (Dinámico)
  
  // Ficha técnica para equipos
  processor         String?           // Ej: "i5 13420H", "Ultra 9 275HX", "R7 8845HS"
  ramCapacity       String?           // Ej: "16GB", "32GB", "8GB DDR5"
  storageCapacity   String?           // Ej: "512GB SSD", "2TB SSD"
  gpu               String?           // Ej: "RTX 3050 4GB", "Integrada"
  screenSize        String?           // Ej: "15.6”"

  isSerialized      Boolean           @default(true) // true = Con N/S Único. false = Control Cuantitativo.
  minStockThreshold Int               @default(2)
  basePrice         Decimal           @db.Decimal(10, 2)
  isSecondHand      Boolean           @default(false)
  createdAt         DateTime          @default(now())

  category          ComponentCategory @relation(fields: [categoryId], references: [id])
  items             HardwareItem[]
  quantityStocks    QuantityStock[]

  @@map("product_catalog")
}

// ------------------------------------------
// 1. PRODUCTOS SERIALIZADOS (Con N/S individual)
// ------------------------------------------
model HardwareItem {
  id              String         @id @default(uuid())
  serialNumber    String         @unique
  catalogId       String
  locationId      String
  status          ItemStatus     @default(EN_STOCK)
  
  // Relación Padre-Hijo para modificaciones/upgrades internos
  parentChassisId String?        
  parentChassis   HardwareItem?  @relation("LaptopComponents", fields: [parentChassisId], references: [id])
  components      HardwareItem[] @relation("LaptopComponents")

  costPrice       Decimal?       @db.Decimal(10, 2)
  salePrice       Decimal?       @db.Decimal(10, 2)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  catalog         ProductCatalog @relation(fields: [catalogId], references: [id])
  location        Location       @relation(fields: [locationId], references: [id])

  saleItems       SaleItem[]
  transferItems   TransferItem[]
  secondHandQueue SecondHandApprovalQueue[]
  serviceItems    ServiceItem[]

  @@map("hardware_items")
}

// ------------------------------------------
// 2. PRODUCTOS POR CANTIDAD (Mouses, Periféricos, Fuentes)
// ------------------------------------------
model QuantityStock {
  id            String         @id @default(uuid())
  catalogId     String
  locationId    String
  quantity      Int            @default(0) // Control de unidades físicas
  costPrice     Decimal?       @db.Decimal(10, 2)
  salePrice     Decimal?       @db.Decimal(10, 2)
  updatedAt     DateTime       @updatedAt

  catalog       ProductCatalog @relation(fields: [catalogId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])

  saleItems     SaleItem[]
  transferItems TransferItem[]

  @@map("quantity_stocks")
}

// ==========================================
// M5: COLA DE APROBACIÓN SEGUNDA MANO
// ==========================================

model SecondHandApprovalQueue {
  id                  String       @id @default(uuid())
  itemId              String
  extractedFromSaleId String?
  requestedByUserId   String
  status              String       @default("PENDING")
  notes               String?
  createdAt           DateTime     @default(now())

  item                HardwareItem @relation(fields: [itemId], references: [id])

  @@map("second_hand_approval_queue")
}

// ==========================================
// M2: VENTAS, GARANTÍAS Y REGALOS (POS)
// ==========================================

model Sale {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  cashierUserId String
  locationId    String
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(EFECTIVO)
  entryMethod   EntryMethod   @default(ESCANER)
  isSynced      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id                   String          @id @default(uuid())
  saleId               String
  itemId               String?         // Ítem único (si aplica)
  quantityStockId      String?         // Stock cuantitativo (si aplica)
  quantity             Int             @default(1)
  unitPrice            Decimal         @db.Decimal(10, 2)
  isGift               Boolean         @default(false)
  isUpgradeReplacement Boolean         @default(false)

  sale                 Sale            @relation(fields: [saleId], references: [id])
  item                 HardwareItem?   @relation(fields: [itemId], references: [id])
  quantityStock        QuantityStock?  @relation(fields: [quantityStockId], references: [id])

  @@map("sale_items")
}

// ==========================================
// M3: LOGÍSTICA Y BORRADORES
// ==========================================

model TransferRequest {
  id               String         @id @default(uuid())
  sourceLocationId String
  targetLocationId String
  senderUserId     String
  receiverUserId   String?
  status           TransferStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceLocation   Location       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  targetLocation   Location       @relation("TargetLocation", fields: [targetLocationId], references: [id])
  senderUser       User           @relation("TransferSender", fields: [senderUserId], references: [id])
  receiverUser     User?          @relation("TransferReceiver", fields: [receiverUserId], references: [id])
  items            TransferItem[]

  @@map("transfer_requests")
}

model TransferItem {
  id                String          @id @default(uuid())
  transferRequestId String
  itemId            String?         // N/S Unico (si aplica)
  quantityStockId   String?         // Stock Cuantitativo (si aplica)
  quantity          Int             @default(1)
  confirmed         Boolean         @default(false)

  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id])
  item              HardwareItem?   @relation(fields: [itemId], references: [id])
  quantityStock     QuantityStock?  @relation(fields: [quantityStockId], references: [id])

  @@map("transfer_items")
}

// ==========================================
// M4: AUDITORÍA EXPRESS Y ESCANEO MÓVIL
// ==========================================

model AuditSession {
  id            String      @id @default(uuid())
  locationId    String
  auditorUserId String
  deviceType    String      @default("PC")
  status        String      @default("IN_PROGRESS")
  createdAt     DateTime    @default(now())

  location      Location    @relation(fields: [locationId], references: [id])
  items         AuditItem[]

  @@map("audit_sessions")
}

model AuditItem {
  id              String       @id @default(uuid())
  auditSessionId  String
  scannedSerial   String
  isDiscrepancy   Boolean      @default(false)
  discrepancyNote String?

  auditSession    AuditSession @relation(fields: [auditSessionId], references: [id])

  @@map("audit_items")
}

// ==========================================
// M7: SERVICIO TÉCNICO
// ==========================================

model TechnicalServiceOrder {
  id                 String        @id @default(uuid())
  ticketNumber       String        @unique
  clientName         String
  clientPhone        String
  deviceModel        String
  reportedFault      String
  technicalDiagnosis String?
  status             ServiceStatus @default(RECIBIDO)
  technicianUserId   String
  laborCost          Decimal       @default(0.00) @db.Decimal(10, 2)
  totalCost          Decimal       @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  technician         User          @relation(fields: [technicianUserId], references: [id])
  serviceItems       ServiceItem[]

  @@map("technical_service_orders")
}

model ServiceItem {
  id             String                @id @default(uuid())
  serviceOrderId String
  itemId         String
  unitPrice      Decimal               @db.Decimal(10, 2)

  serviceOrder   TechnicalServiceOrder @relation(fields: [serviceOrderId], references: [id])
  item           HardwareItem          @relation(fields: [itemId], references: [id])

  @@map("service_items")
}

// ==========================================
// M8: HISTORIAL Y CIERRE DE CAJA
// ==========================================

model CashClosing {
  id              String   @id @default(uuid())
  locationId      String
  userId          String
  totalCashFound  Decimal  @db.Decimal(10, 2)
  amountWithdrawn Decimal  @db.Decimal(10, 2)
  retainedBalance Decimal  @db.Decimal(10, 2)
  expectedBalance Decimal  @db.Decimal(10, 2)
  difference      Decimal  @db.Decimal(10, 2)
  notes           String?
  closedAt        DateTime @default(now())

  location        Location @relation(fields: [locationId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@map("cash_closings")
}

// ==========================================
// M6: BITÁCORA INALTERABLE (AUDIT LOG)
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  payload   Json
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}